{
  "version": 1,

  "dyna_watch_dir": "D:/DynaID",
  "dyna_glob": "dyna*.txt",
  "delete_after_read": true,

  "outputs_dir": "data/sessions",
  "wav_dir": "data/wav",
  "llm_outputs_dir": "data/llm",
  "memo_outputs_dir": "data/memo/outputs",
  "memo_templates_path": "./memo_templates.json",
  "correction_rules_path": "./corrections.json",
  "wav_expire_days": 7,
  "windows_launcher": {
    "auto_start_server": false
  },
  
  "port": 8000,

  "vad": {
    "mode": "auto",
    "manual_threshold_db": -42.0,
    "calibration_sec": 1.5,
    "margin_db": 10.0,
    "min_threshold_db": -55.0,
    "max_threshold_db": -20.0,
    "noise_window_sec": 6.0,
    "update_margin_db": 3.0,
    "quiet_percentile": 20.0,
    "start_voice_frames": 3,
    "end_silence_frames": 12,
    "pre_roll_ms": 300,
    "min_sec": 0.4,
    "max_sec": 20.0
  },

  "ssl": {
    "enabled": false,
    "certfile": "certs/cert.pem",
    "keyfile": "certs/key.pem"
  },

  "asr": {
    "enabled": true,
    "provider": "whisper",
    "model_id": "small",

    "qwen": {
      "base_url": "http://127.0.0.1:8010",
      "timeout_sec": 35,
      "language": "Japanese",
      "context": "日本の医療現場の会話。聞こえたとおりに書き起こす。推測で補完しない。",
      "managed_by_launcher": true,
      "model_alias": "1.7b",
      "executable_path": "../QwenASR/dist/QwenASR-Server/QwenASR-Server.exe",
      "config_path": "../QwenASR/dist/QwenASR-Server/config.json",
      "startup_timeout_sec": 90
    },

    "vibevoice": {
      "base_url": "http://127.0.0.1:8020",
      "timeout_sec": 135,
      "language": "Japanese",
      "context": "日本の医療現場の会話。聞こえたとおりに書き起こす。推測で補完しない。",
      "hotwords": [
        "滲出性中耳炎",
        "鼓膜切開"
      ],
      "include_segments": true,
      "managed_by_launcher": false,
      "model_alias": "7b",
      "python_executable": "../VibeVoiceASR/.venv/Scripts/python.exe",
      "server_script": "../VibeVoiceASR/server.py",
      "config_path": "../VibeVoiceASR/config.json",
      "startup_timeout_sec": 180
    },

    "models": {
      "small": "models/small",
      "medium": "models/models--Systran--faster-whisper-medium",
      "large-v3": "models/models--Systran--faster-whisper-large-v3",
      "large-v3-turbo": "models/models--mobiuslabsgmbh--faster-whisper-large-v3-turbo",
      "kotoba-v2.2": "models/models--kotoba-tech--kotoba-whisper-v2.2-faster"
    },

    "language": "ja",
    "device": "cpu",
    "compute_type": "int8",
    "beam_size": 5,
    "temperature": 0.0,
    "condition_on_previous_text": false,
    "initial_prompt": "日本の医療現場の会話。聞こえたとおりに書き起こす。推測で補完しない。薬剤名は聞こえた通りに。"
  },

  "llm": {
    "server": "127.0.0.1",
    "port": 11434,
    "use_https": false,
    "api_key": "",
    "api_key_env": "",
    "model_default": "gemma4:12b",
    "timeout": 120,
    "temperature": 0.0,
    "top_p": 0.9,
    "reasoning_enabled": false,
    "default_prompt_id": "soap_v1",
    "memo_default_prompt_id": "proofread",
    "memo_prompts": {
      "proofread": {
        "label": "誤字脱字を修正",
        "template": "以下は音声入力された医療メモです。内容や意味を変えず、誤字脱字、句読点、明らかな音声認識の誤変換だけを修正してください。情報を追加・推測せず、修正後の本文だけを出力してください。\n\n【メモ】\n{text}"
      },
      "polish": {
        "label": "医療文書として清書",
        "template": "以下は音声入力された医療メモです。事実を追加・推測せず、内容を保ったまま、読みやすく丁寧な医療文書として清書してください。不明な箇所は補完せず［要確認］とし、本文だけを出力してください。\n\n【メモ】\n{text}"
      },
      "referral_letter": {
        "label": "紹介状形式に整形",
        "template": "以下の音声入力を、診療情報提供書・紹介状の文案として整理してください。紹介目的、傷病名、経過、所見・検査、治療内容、依頼事項を、入力に存在する範囲だけで構成してください。情報を追加・推測せず、不足項目は［未入力］としてください。完成した本文だけを出力してください。\n\n【音声入力】\n{text}"
      }
    },
    "correction_tool_default_prompt_id": "correction_v1",
    "correction_tool_prompts": {
      "correction_v1": {
        "label": "誤変換補正候補 v1",
        "template": "以下は耳鼻科診察会話のASRテキストです。明らかな誤変換だけを高精度で抽出してください。返答はJSON配列のみで、各要素は{{\"wrong\":\"誤変換\",\"correct\":\"正しい語\",\"reason\":\"短い理由\"}}の形式。最大10件。自信が低いものは出さないでください。候補が1件でも必ず配列で返し、候補がなければ [] を返してください。説明文、Markdown、コードフェンス、<think> は出力しないでください。\n\n{transcript}\n"
      }
    },
    "so_labeler_default_prompt_id": "boundary_v1",
    "so_labeler_prompts": {
      "boundary_v1": {
        "label": "S/O境界判定 v1",
        "template": "以下は耳鼻科診察会話の発話列です。目的は、prev_text と next_text の間で問診(S)から診察・所見(O)に切り替わるかを判定することです。\n\n判定の観点:\n- S: 症状確認、経過確認、問診、患者訴えの確認\n- O: 診察開始、観察、所見確認、身体診察への移行\n- 「見ていきますね」「お口開けて」「喉を見ます」のような診察開始の合図を重視する\n- 単なる相槌や言い換えでは境界にしない\n\ncontext_before:\n{context_before}\n\nprev_text:\n{prev_text}\n\nnext_text:\n{next_text}\n\ncontext_after:\n{context_after}\n"
      }
    },

    "prompts": {
      "soap_v1": {
        "label": "SOAP(発熱重視)",
        "template": "以下は医者と患者の診察室での会話（主に医者の発言）です。音声認識のため同音異義語(「咳」→「席」、「鼻」→「花」など)が混ざります。それを考慮して、SOAP形式に要約してください。\n\n重要な制約:\n- 勝手に情報を追加しない（会話に無いことは書かない）\n- 不明なことは「不明」とし、推測しない\n- 可能なら箇条書き、特にS)の部分はなるべく時系列で簡潔に\n -体温と思われる情報は必ずSに記載 \n出力はSOAPのみ（前置き・思考過程不要）。\n\n【会話テキスト】\n{asr_text}\n"
      },
      "translate": {
        "label": "英語翻訳",
        "template": "以下は診察会話を英語に翻訳してください。主に医者の発言部分のテキストですが、音声認識のため変換ミスが見られます。「咳」→「席」、「鼻」→「花」など文脈から間違いと思われるものを修正し、質問に対する返答の「うん」「はい」「ええ」等は必ず残し、言ってもないことを追加することなく、英語で出力してください。【会話テキスト】\n{asr_text}\n"
      },
      "yomi_correct": {
        "label": "誤変換訂正",
        "template": "以下は診察会話で主に医者の発言部分のテキストですが、音声認識のため変換ミスが見られます。「咳」→「席」、「鼻」→「花」など文脈から間違いと思われるものを修正し、質問に対する返答の「うん」「はい」「ええ」等は必ず残し、言ってもないことを追加することなく出力してください。【会話テキスト】\n{asr_text}\n"
      }
    }
  },

  "hearing_translation": {
    "enabled": true,
    "model": "翻訳に使用するOllamaモデルID",
    "timeout": 30,
    "default_language": "en",
    "languages": [
      { "id": "en", "label": "英語", "name": "English" },
      { "id": "zh", "label": "中国語", "name": "Simplified Chinese" },
      { "id": "ko", "label": "韓国語", "name": "Korean" }
    ]
  },

  "auto_llm": false,
  "auto_llm_prompts": [
    {
      "model_id": "gemma4:12b",
      "prompt_id": "soap_v1",
      "asr_correct": true
    }
  ]
}
